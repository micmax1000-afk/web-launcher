<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView android:id="@+id/sHeader" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="📈 Borsa" android:textColor="#FF5B8CFF" android:textSize="13sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
        <TextView android:id="@+id/s1n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#FFF0F4FA" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/s1v" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFB0B8C8" android:textSize="14sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
        <TextView android:id="@+id/s2n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#FFF0F4FA" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/s2v" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFB0B8C8" android:textSize="14sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
        <TextView android:id="@+id/s3n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#FFF0F4FA" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/s3v" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFB0B8C8" android:textSize="14sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
        <TextView android:id="@+id/s4n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#FFF0F4FA" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/s4v" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFB0B8C8" android:textSize="14sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
        <TextView android:id="@+id/s5n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#FFF0F4FA" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/s5v" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFB0B8C8" android:textSize="14sp" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
