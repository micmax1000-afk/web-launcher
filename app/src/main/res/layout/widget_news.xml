<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView android:id="@+id/nHeader" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="📰 Notizie" android:textColor="#FF5B8CFF" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/n1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:textColor="#FFF0F4FA" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/n2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:textColor="#FFF0F4FA" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/n3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:textColor="#FFF0F4FA" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/n4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:textColor="#FFF0F4FA" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
