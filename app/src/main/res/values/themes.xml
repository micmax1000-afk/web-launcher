<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WebLauncher" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="colorSurface">@color/bg_elevated</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:textColorHint">@color/hint_neutral</item>
        <item name="android:editTextColor">@color/text</item>
        <!-- finestre e menu Material 3: stessi colori dell'app, chiari o scuri insieme -->
        <item name="colorSurfaceContainerLowest">@color/bg_elevated</item>
        <item name="colorSurfaceContainerLow">@color/bg_elevated</item>
        <item name="colorSurfaceContainer">@color/bg_elevated</item>
        <item name="colorSurfaceContainerHigh">@color/bg_elevated</item>
        <item name="colorSurfaceContainerHighest">@color/bg_elevated</item>
        <item name="colorOnSurfaceVariant">@color/text_muted</item>
    </style>

    <style name="Theme.WebLauncher.Amber" parent="Theme.WebLauncher">
        <item name="colorPrimary">@color/accent_amber</item>
        <item name="colorSecondary">@color/accent_amber</item>
    </style>
    <style name="Theme.WebLauncher.Green" parent="Theme.WebLauncher">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorSecondary">@color/accent_green</item>
    </style>
    <style name="WidgetLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">#FFF0F4FA</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="WidgetButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFF0F4FA</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>

